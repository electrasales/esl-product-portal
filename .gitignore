# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# design canvas: keep the .dc.html/.json sources, skip the generated
# multi-MB seeded payload (regenerate with design/seed-canvas.mjs)
design/*.html
!design/Main.dc.html
!design/Login.dc.html
!design/Cart.dc.html

# typescript
*.tsbuildinfo
next-env.d.ts
